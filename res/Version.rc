#include <windows.h>

#define VER_FILEVERSION             1,1,2,0
#define VER_FILEVERSION_STR         "1.1.2.0\0"
#define VER_PRODUCTVERSION          1,1,2,0
#define VER_PRODUCTVERSION_STR       "v1.1.2\0"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     VER_FILEVERSION
PRODUCTVERSION  VER_PRODUCTVERSION
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0" // 简体中文 (0x0804) + Unicode (0x04b0)
        BEGIN
            VALUE "CompanyName",      "Simon Chen\0"
            VALUE "FileDescription",  "MiPlugin-Traff 小米智能插座电力监控插件\0"
            VALUE "FileVersion",      VER_FILEVERSION_STR
            VALUE "InternalName",     "XiaomiPlugPlugin.dll\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Sim-OpenSource. All rights reserved.\0"
            VALUE "OriginalFilename", "XiaomiPlugPlugin.dll\0"
            VALUE "ProductName",      "MiPlugin-Traff\0"
            VALUE "ProductVersion",   VER_PRODUCTVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 0x04b0
    END
END
